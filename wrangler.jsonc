{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "3dschool",
  "main": "cloudflare/worker.js",
  "compatibility_date": "2026-09-28",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/zhihu-callback"],
    "not_found_handling": "single-page-application"
  },
  "vars": {
    "ZHIHU_APP_ID": "851",
    "ZHIHU_REDIRECT_URI": "https://museum.chipai.cc/zhihu-callback"
  },
  "d1_databases": [{
    "binding": "AUTH_DB",
    "database_name": "3dschool-auth",
    "database_id": "960c27c0-6d13-4dc8-a486-033b3fda3f14",
    "migrations_dir": "cloudflare/migrations"
  }]
}
